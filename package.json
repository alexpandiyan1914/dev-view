{
  "name": "dev-view",
  "version": "0.1.0",
  "description": "A clear view of your project's health. Finds problems like committed secrets and generated files, explains why they matter and how to fix them. Works on local folders and public GitHub repositories.",
  "keywords": [
    "cli",
    "developer-tools",
    "project-health",
    "repository",
    "hygiene",
    "audit",
    "secrets",
    "gitignore",
    "env",
    "nodejs",
    "python",
    "github"
  ],
  "homepage": "https://github.com/alexpandiyan1914/dev-view#readme",
  "bugs": {
    "url": "https://github.com/alexpandiyan1914/dev-view/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexpandiyan1914/dev-view.git"
  },
  "type": "module",
  "bin": {
    "dev-view": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && node scripts/check-package.mjs"
  },
  "author": "Alexpandiyan",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}